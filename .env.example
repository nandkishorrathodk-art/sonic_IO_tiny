# ============================================
# SONIC-REDA — Environment Variables Template
# ============================================
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file!
# ============================================

# ---- Google OAuth2 (Team-Only Auth) ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Comma-separated list of allowed emails (leave empty if using domain)
ALLOWED_EMAILS=you@gmail.com,teammate@gmail.com

# Comma-separated list of allowed Google Workspace domains
ALLOWED_DOMAINS=

# JWT signing secret (generate: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=CHANGE-ME-generate-a-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ---- LLM API Keys (only add what you use) ----
# Default provider configured in configs/models.yaml is "nvidia" (NVIDIA NIM,
# OpenAI-compatible). Set NVIDIA_API_KEY + NVIDIA_BASE_URL to use it, or point
# DEFAULT_LLM_PROVIDER at another configured provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# NVIDIA NIM (default provider in configs/models.yaml)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Local LLM endpoint (Ollama / vLLM)
LOCAL_LLM_URL=http://localhost:11434

# Default provider: nvidia | claude | openai | grok | deepseek | local
DEFAULT_LLM_PROVIDER=nvidia

# ---- Neo4j (Graph Memory) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sonic-reda-dev

# ---- Redis (Cache / Queue) ----
REDIS_URL=redis://localhost:6379/0

# ---- Application ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- Production secret injection (docker-compose.prod.yml) ----
# When APP_ENV=production, these MUST be set to strong random values.
# The API refuses to boot if SECRET_KEY is unset or a known default.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
NEO4J_PASSWORD=

# ---- Docker graphical workstation / isolated labs ----
# Required when running docker-compose.yml.  Use a long random value; the
# workstation refuses to start a passwordless VNC server.
SONIC_VNC_PASSWORD=generate-a-long-random-vnc-password

# Optional, exact hostnames only.  TLS verification remains enabled for every
# other destination; leave empty unless a controlled lab uses a self-signed CA.
SONIC_INSECURE_TLS_HOSTS=

# ---- Self-Developer real lab commands ----
SONIC_EVOLUTION_SYNTAX_COMMAND=python -m compileall -q .
SONIC_EVOLUTION_TYPE_COMMAND=python -m mypy .
SONIC_EVOLUTION_UNIT_COMMAND=python -m pytest -q
SONIC_EVOLUTION_INTEGRATION_COMMAND=python -m pytest -q tests/integration
SONIC_EVOLUTION_SECURITY_COMMAND=python -m pytest -q tests/security
SONIC_SELF_DEVELOPER_TEST_COMMAND=python -m pytest -q tests/security tests/integration

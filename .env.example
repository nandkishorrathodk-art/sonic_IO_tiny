# ============================================
# SONIC-REDA — Environment Variables Template
# ============================================
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file!
# ============================================

# ---- Google OAuth2 (Team-Only Auth) ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Comma-separated list of allowed emails (leave empty if using domain)
ALLOWED_EMAILS=you@gmail.com,teammate@gmail.com

# Comma-separated list of allowed Google Workspace domains
ALLOWED_DOMAINS=

# JWT signing secret (generate: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=CHANGE-ME-generate-a-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ---- LLM API Keys (only add what you use) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Local LLM endpoint (Ollama / vLLM)
LOCAL_LLM_URL=http://localhost:11434

# Default provider: claude | openai | grok | deepseek | local
DEFAULT_LLM_PROVIDER=claude

# ---- Neo4j (Graph Memory) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sonic-reda-dev

# ---- Redis (Cache / Queue) ----
REDIS_URL=redis://localhost:6379/0

# ---- Application ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ==============================================================================
# SONIC-REDA — Isolated Kali Linux Sandbox (Security Tool Plane)
# ==============================================================================
# Build:  docker build -t sonic-kali-linux:v1.3.0 -f docker/Dockerfile.kali-sandbox .
#
# The control plane requests `sonic-kali-linux:v1.3.0` for KALI_SECURITY
# profiles (see sonic/computer/provider.py); build with THIS tag so
# provisioning actually succeeds instead of `docker pull access denied`.


FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive

# Install generic execution prerequisites only. Target-specific capabilities
# are supplied explicitly at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    python3 \
    python3-pip \
    iproute2 \
    iptables \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Create non-root sonic operator user
RUN useradd -m -s /bin/bash -u 1000 sonic \
    && mkdir -p /workspace \
    && chown -R sonic:sonic /workspace

WORKDIR /workspace
USER sonic

CMD ["tail", "-f", "/dev/null"]
